# Kopijuokite į .env.cloud-e2e.local (šalia package.json) ir užpildykite tikrus raktus.
# Vite režimas: vite build --mode cloud-e2e → krauna .env.cloud-e2e.local
#
# npm run test:cloud — Playwright debesies smoke (tik su galiojančiais VITE_SUPABASE_*)

VITE_ALLOW_OFFLINE_CRM=false
VITE_DEMO_MODE=false

VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_at_least_32_chars
